{
  "name": "web-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web-utils/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}", "{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/libs/web-utils"],
      "defaultConfiguration": "production",
      "options": {
        "outDir": "../../dist/libs/web-utils"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/web-utils"],
      "options": {
        "coverage.reportsDirectory": "../../coverage/libs/web-utils"
      }
    }
  }
}
