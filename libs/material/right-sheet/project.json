{
  "name": "material-right-sheet",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/material/right-sheet/src",
  "prefix": "mat",
  "tags": [],
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/{projectRoot}", "{projectRoot}"]
    }
  },
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/material/right-sheet"],
      "options": {
        "project": "libs/material/right-sheet/ng-package.json",
        "tsConfig": "libs/material/right-sheet/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/material/right-sheet/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "buildTarget": "material-right-sheet:test-zone-env",
        "setupFiles": ["libs/material/right-sheet/src/test-setup.ts"],
        "browsers": ["chromiumHeadless"]
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test-zone-env": {
      "executor": "@angular/build:application",
      "metadata": {
        "description": "Not meant to be run. Supplies zone.js polyfills to the unit-test target: for library build targets the Angular unit-test builder loads zone.js after @angular/core/testing, which breaks fakeAsync()."
      },
      "options": {
        "browser": "libs/material/right-sheet/src/index.ts",
        "tsConfig": "libs/material/right-sheet/tsconfig.spec.json",
        "polyfills": ["zone.js"],
        "outputPath": "dist/out-tsc/material-right-sheet-test-zone-env"
      }
    }
  }
}
