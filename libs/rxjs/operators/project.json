{
  "name": "rxjs-operators",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/rxjs/operators/src",
  "projectType": "library",
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "preserveLocalDependencyProtocols": false,
      "manifestRootsToUpdate": ["dist/{projectRoot}", "{projectRoot}"]
    }
  },
  "tags": [],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["{projectRoot}/{options.outDir}", "{workspaceRoot}/dist/libs/rxjs/operators"],
      "options": {
        "outDir": "../../../dist/libs/rxjs/operators"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "test": {
      "outputs": ["{projectRoot}/{options.coverage.reportsDirectory}", "{workspaceRoot}/coverage/libs/rxjs-operators"],
      "options": {
        "coverage.reportsDirectory": "../../../coverage/libs/rxjs-operators"
      }
    }
  }
}
